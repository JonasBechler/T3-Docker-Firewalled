# Copy to .env to pin versions. Leave unset (or "latest") to track the newest release.
# T3_VERSION=latest
# CODEX_VERSION=latest
# CLAUDE_CODE_VERSION=latest

# Optional: API keys instead of interactive provider logins
# (also uncomment the matching lines in docker-compose.yml)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
