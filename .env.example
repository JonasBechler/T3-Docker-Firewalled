# Copy to .env and uncomment what you need. Versions: unset (or "latest") tracks the newest release.
# T3_VERSION=latest
# CODEX_VERSION=latest
# CLAUDE_CODE_VERSION=latest

# Optional: API keys instead of interactive provider logins
# (also uncomment the matching lines in docker-compose.yml)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Ports on this machine. Change them for a second instance (see README).
# T3_PORT=3773
# SSH_PORT=2222

# SSH (user "node"). Default: this machine only.
# Set SSH_BIND=0.0.0.0 to allow logins from other machines on your network.
# SSH_BIND=127.0.0.1
# Password login on top of keys. Leave empty for keys only.
# Agents in the container can read it, so use a long password used nowhere else,
# and prefer keys only when SSH_BIND=0.0.0.0. Single quotes keep "$" literal.
# SSH_PASSWORD='...'
